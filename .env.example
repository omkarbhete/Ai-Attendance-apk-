# AWS RDS PostgreSQL Configuration
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=snapclass
DB_USERNAME=snapclass_admin
DB_PASSWORD=your-secure-password

# AWS ElastiCache Redis Configuration
REDIS_ENDPOINT=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_AUTH_TOKEN=your-redis-auth-token

# AWS S3 Configuration
S3_BUCKET=snapclass-prod-assets-unique-suffix
AWS_REGION=us-east-1

# Application Configuration
APP_ENV=production
APP_SECRET_KEY=your-secret-key-here
LOG_LEVEL=INFO

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Health Check Configuration
HEALTH_CHECK_PORT=8502

# Note: In production, these values are loaded from AWS Systems Manager Parameter Store
# and AWS Secrets Manager. This file is for local development reference only.